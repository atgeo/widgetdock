{
  "name": "widgetdock",
  "version": "0.1.0",
  "type": "module",
  "description": "A widget toolkit for streaming and webviews",
  "author": "Georges Kmeid",
  "keywords": [
    "widgets"
  ],
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build:ts && npm run build:css",
    "build:ts": "tsc",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:css": "npx tailwindcss -i src/styles/input.css --o public/css/tailwind.css --watch",
    "build:css": "npx tailwindcss -i src/styles/input.css -o public/css/tailwind.css --minify",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle-migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "private": true,
  "dependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "country-emoji": "^2.0.1",
    "drizzle-orm": "^0.45.2",
    "ejs": "^6.0.1",
    "express": "^5.2.1",
    "express-jwt": "^8.5.1",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.15.0",
    "pg": "^8.23.0",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^26.5.1",
    "@types/pg": "^8.23.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
