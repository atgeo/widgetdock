{
  "name": "widgetdock",
  "version": "0.1.0",
  "type": "module",
  "description": "A widget toolkit for streaming and webviews",
  "author": "Georges Kmeid",
  "keywords": [
    "widgets"
  ],
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build:ts && npm run build:css",
    "build:ts": "tsc",
    "dev": "tsx watch --env-file=.env src/server.ts",
    "dev:css": "postcss src/styles/*.css --dir public/css --watch",
    "build:css": "NODE_ENV=production postcss src/styles/*.css -d public/css",
    "drizzle:generate": "drizzle-kit generate",
    "drizzle-migrate": "drizzle-kit migrate",
    "db:seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "engines": {
    "node": ">=25.0.0 <26.0.0"
  },
  "private": true,
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "country-emoji": "^1.5.6",
    "drizzle-orm": "^0.44.7",
    "ejs": "^3.1.10",
    "express": "^5.1.0",
    "express-jwt": "^8.5.1",
    "jsonwebtoken": "^9.0.2",
    "openai": "^6.9.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "drizzle-kit": "^0.31.7",
    "postcss-cli": "^11.0.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
