{
  "name": "widgetdock",
  "version": "0.1.0",
  "type": "module",
  "description": "A widget toolkit for streaming and webviews",
  "author": "Georges Kmeid",
  "keywords": [
    "widgets"
  ],
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "npm run build:ts && npm run build:css",
    "build:ts": "tsc",
    "start": "node --env-file:.env dist/server.js",
    "dev": "nodemon --env-file=.env dist/server.js",
    "dev:css": "postcss src/styles/*.css --dir public/css --watch",
    "build:css": "NODE_ENV=production postcss src/styles/*.css -d public/css"
  },
  "private": true,
  "dependencies": {
    "@tailwindcss/postcss": "^4.1.17",
    "country-emoji": "^1.5.6",
    "express": "^5.1.0",
    "openai": "^6.9.0",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.17"
  },
  "devDependencies": {
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "nodemon": "^3.1.11",
    "postcss-cli": "^11.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
