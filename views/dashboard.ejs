<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Dashboard - WidgetDock</title>
    <link rel="stylesheet" href="/css/home.css">
</head>
<body class="bg-gray-100 min-h-screen flex flex-col items-center">

<!-- Header -->
<header class="w-full flex justify-between items-center p-4 bg-white shadow">
    <h1 class="text-xl font-bold text-gray-800">WidgetDock</h1>
    <div class="flex items-center gap-4">
        <span class="text-gray-600">Hello, <%= user.username %>!</span>
        <a href="/auth/logout" class="px-3 py-1 bg-red-600 text-white rounded hover:bg-red-700 transition">
            Logout
        </a>
    </div>
</header>

<!-- Dashboard Widgets -->
<main class="w-full max-w-4xl flex flex-col gap-6 p-4 mt-8">
    <h2 class="text-2xl font-bold text-gray-800 mb-4">Your Widgets</h2>

    <% widgets.forEach(widget => { %>
        <a href="/w/<%= widget.slug %>" class="block bg-white p-6 rounded-xl shadow hover:shadow-lg transition">
            <h3 class="font-bold text-lg"><%= widget.name %></h3>
            <p class="text-gray-600">Click to open <%= widget.name %> widget</p>
        </a>
    <% }) %>
</main>

<footer class="text-center p-4 text-gray-500 mt-8 w-full">
    &copy; 2025 WidgetDock. All rights reserved.
</footer>

</body>
</html>
